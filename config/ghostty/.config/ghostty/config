font-family = JetBrainsMono Nerd Font
font-size = 14

# Ghostty's built-in default is already dark.
# Browse alternatives with: ghostty +list-themes
# theme = Catppuccin Mocha

window-padding-x = 10
window-padding-y = 10

cursor-style = block
copy-on-select = true


# Keybindings
keybind = cmd+shift+c=copy_to_clipboard
keybind = cmd+shift+v=paste_from_clipboard

keybind = cmd+shift+n=new_window
keybind = cmd+shift+w=close_window

keybind = cmd+n=new_tab
keybind = cmd+shift+]=next_tab
keybind = cmd+shift+[=previous_tab

keybind = cmd+shift+f=toggle_fullscreen
